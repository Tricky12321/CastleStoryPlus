<Project Sdk="Microsoft.NET.Sdk">
  <!-- Developer tools for Castle Story Plus (BepInEx 5 plugin, never shipped in releases): an HTTP API on
       localhost into the running game, and the in-game test runner with its tests. Builds against the ORIGINAL game
       assemblies (Managed.orig), like the mod. -->
  <PropertyGroup>
    <AssemblyName>CastleStoryPlus.DevTools</AssemblyName>
    <RootNamespace>CastleStoryPlus.DevTools</RootNamespace>
    <VanillaManagedDir>$(GameDir)Castle Story_Data/Managed.orig/</VanillaManagedDir>
    <BepInExCoreDir>$(GameDir)BepInEx/core/</BepInExCoreDir>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The mod itself; loaded by BepInEx from its own folder, so never copied next to this plugin. -->
    <ProjectReference Include="..\CastleStoryPlus\CastleStoryPlus.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp-firstpass" Publicize="true">
      <HintPath>$(VanillaManagedDir)Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brix.Core" Publicize="true">
      <HintPath>$(VanillaManagedDir)Brix.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="brix-common">
      <HintPath>$(VanillaManagedDir)brix-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCoreDir)BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCoreDir)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedDir)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Networking" Publicize="true">
      <HintPath>$(GameManagedDir)UnityEngine.Networking.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(GameManagedDir)System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameManagedDir)Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MoonSharp.Interpreter">
      <HintPath>$(GameManagedDir)MoonSharp.Interpreter.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Smooth.Foundations">
      <HintPath>$(GameManagedDir)Smooth.Foundations.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <!-- Into the game's BepInEx/plugins folder, next to (not inside) the mod's folder. -->
  <Target Name="InstallPlugin" AfterTargets="Build" Condition="Exists('$(GameDir)BepInEx/plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx/plugins/CastleStoryPlus.DevTools/" />
  </Target>
</Project>
