<Project>
  <!-- The Essentials edition (dotnet build -p:Edition=Essentials, see docs/Editions.md): the code, Lua and files of
       every feature that is "Out" in docs/Editions.md are not compiled or shipped. Whole files and folders are removed
       here; code of those features inside files that stay is under #if !ESSENTIALS. tools/check-editions.py checks
       that every Out feature's [Feature] classes are left out this way. The Full edition builds everything, as before,
       except the Essentials artwork. -->

  <!-- The mod. -->
  <ItemGroup Condition="'$(Edition)' == 'Essentials' And '$(MSBuildProjectName)' == 'CastleStoryPlus'">
    <!-- Folders that are Out as a whole. -->
    <Compile Remove="Achievements/**" />
    <Compile Remove="Experience/**" />
    <Compile Remove="Giant/**" />
    <Compile Remove="Market/**" />
    <Compile Remove="Metallurgy/**" />
    <Compile Remove="Respawn/**" />
    <Compile Remove="Treasure/**" />
    <Compile Remove="Upgrades/**" />
    <Compile Remove="Weather/**" />
    <Compile Remove="WorldGen/**" />
    <!-- Army: call to arms, posts, guard, kits. -->
    <Compile Remove="Army/KitBundles.cs;Army/CallToArms.cs;Army/CallToArmsHooks.cs;Army/CallToArmsNetwork.cs;Army/CallToArmsPanel.cs;Army/CallToArmsSettings.cs;Army/RackEquipDrop.cs;Army/RangedGuard.cs;Army/SoldierOrders.cs;Army/SoldierPosts.cs" />
    <!-- Building: new blocks, buildings, storage and building tools. -->
    <Compile Remove="Building/BlockAnchor.cs;Building/BlueprintVisibilityPatch.cs;Building/BuildBlocked.cs;Building/BuildNeeds.cs;Building/BuildNeedsMenu.cs;Building/BuildPriority.cs;Building/BuildShortage.cs;Building/CopyPaste.cs;Building/CustomBlocks.cs;Building/Demolish.cs;Building/EmptyStockpile.cs;Building/Eyedropper.cs;Building/EyedropperPatch.cs;Building/LadderSupport.cs;Building/LargeStockpile.cs;Building/LargeStockpileVisual.cs;Building/LongStoneTexture.cs;Building/MixedRacks.cs;Building/MixedStockpiles.cs;Building/MoveStructure.cs;Building/RackFilter.cs;Building/RoofItems.cs;Building/SidePlanks.cs;Building/SlabOnPlanks.cs;Building/StockpileHeadroom.cs;Building/StockpileSpill.cs;Building/Warehouse.cs;Building/WarehouseModel.cs;Building/WoodOverhang.cs" />
    <!-- Combat: new abilities, enemies and balance. -->
    <Compile Remove="Combat/ArcherAccuracyPatch.cs;Combat/GlowTint.cs;Combat/ArtificerHealing.cs;Combat/CriticalHits.cs;Combat/Healtron.cs;Combat/HealtronPatches.cs;Combat/Retreat.cs;Combat/WallLean.cs" />
    <!-- Economy: new workshop and quarry controls, dark crystals, the energy multiplier. -->
    <Compile Remove="Economy/CraftLoopLimit.cs;Economy/DarkCrystalStockpileWheel.cs;Economy/DarkCrystals.cs;Economy/EnergyPatch.cs;Economy/QuarryDepth.cs;Economy/QuarryLimit.cs;Economy/WorkshopFetchRange.cs;Economy/WorkshopFetchRangeBlueprints.cs;Economy/WorkshopPriority.cs;Economy/WorkshopSetup.cs" />
    <Compile Remove="Invasion/SpawnDistance.cs" />
    <Compile Remove="Menus/AutoContinue.cs;Menus/ContinueButtonPatch.cs;Menus/DialogButtonsPatch.cs;Menus/SpeedKeys.cs;Menus/WaveInterval.cs" />
    <Compile Remove="Multiplayer/GameChat.cs;Multiplayer/MaxPlayers.cs" />
    <Compile Remove="Nature/SaplingArea.cs;Nature/Saplings.cs;Nature/TreeFarm.cs;Nature/TreeStumps.cs;Nature/WildPlants.cs;Nature/WornPaths.cs;Nature/WiderVision.cs" />
    <Compile Remove="Pathfinding/Ladders.cs;Pathfinding/Roads.cs;Pathfinding/RoadsSync.cs" />
    <Compile Remove="Saving/AutoSave.cs" />
    <Compile Remove="Diagnostics/SpawnView.cs" />
    <Compile Remove="UI/CameraZoomOut.cs;UI/TextureRecolour.cs;UI/EnergyHint.cs;UI/ItemHint.cs;UI/MinimapTerrain.cs;UI/MinimapZoom.cs;UI/ResourceList.cs;UI/ResourceSeen.cs;UI/StockpileTooltip.cs;UI/TaskCrewSizeLobby.cs;UI/WardRangeFade.cs;UI/WaveDirection.cs;UI/WaveWarning.cs;UI/WorldSearch.cs" />
    <Compile Remove="WorkerAI/AutoCleanup.cs;WorkerAI/AutoRepair.cs;WorkerAI/BaseJobs.cs;WorkerAI/BaseRanges.cs;WorkerAI/DirectTask.cs;WorkerAI/LargerTasks.cs;WorkerAI/PauseTasks.cs;WorkerAI/PriorityLevels.cs;WorkerAI/QuarrySpeed.cs;WorkerAI/ResourcePriority.cs;WorkerAI/TaskCrewSize.cs;WorkerAI/UnreachableThought.cs;WorkerAI/WorkLimit.cs;WorkerAI/StockpileConsolidation.cs;WorkerAI/StockpileConsolidationPatch.cs;WorkerAI/Logic/ConsolidationPile.cs;WorkerAI/Logic/ConsolidationRules.cs;WorkerAI/Logic/ConsolidationSettings.cs" />
    <Compile Remove="Workers/DropGearOnDeath.cs" />
  </ItemGroup>

  <!-- The menu assembly and the developer tools see the left-out folders' namespaces too (empty), so their using
       directives can stay. -->
  <ItemGroup Condition="'$(Edition)' == 'Essentials' And ('$(MSBuildProjectName)' == 'CastleStoryPlus.UI' Or '$(MSBuildProjectName)' == 'CastleStoryPlus.DevTools')">
    <Compile Include="$(MSBuildThisFileDirectory)CastleStoryPlus/Core/EditionNamespaces.cs" Link="EditionNamespaces.cs" />
  </ItemGroup>

  <!-- The menu assembly: the windows of Out features. -->
  <ItemGroup Condition="'$(Edition)' == 'Essentials' And '$(MSBuildProjectName)' == 'CastleStoryPlus.UI'">
    <Compile Remove="GameUi/MarketWindow.cs;GameUi/RackFilterWindow.cs;GameUi/ResourceListView.cs;GameUi/ResourcePriorityView.cs;GameUi/UpgradeWindow.cs" />
  </ItemGroup>

  <!-- The developer tools: the in-game tests, endpoints and test worlds of Out features. -->
  <ItemGroup Condition="'$(Edition)' == 'Essentials' And '$(MSBuildProjectName)' == 'CastleStoryPlus.DevTools'">
    <Compile Remove="Tests/AchievementTests.cs;Tests/CoalStockpileTests.cs;Tests/ConsolidationTests.cs;Tests/DemolishTests.cs;Tests/DirectTaskTests.cs;Tests/GuardianSoundTests.cs;Tests/KitBundleTests.cs;Tests/ResourcePriorityTests.cs;Tests/RoadTests.cs;Tests/RoofItemTests.cs;Tests/SavedContentTests.cs;Tests/SprintTests.cs;Tests/TreasureTests.cs;Tests/WeatherTests.cs" />
    <Compile Remove="Endpoints/AchievementEndpoints.cs;Endpoints/RandomWorldEndpoints.cs;Endpoints/SpawnEndpoints.cs;Endpoints/TreasureEndpoints.cs;Endpoints/WeatherEndpoints.cs;Worlds/PhotoStudio.cs" />
  </ItemGroup>

  <!-- The local tests with the game's assemblies: the tests of Out features. -->
  <ItemGroup Condition="'$(Edition)' == 'Essentials' And '$(MSBuildProjectName)' == 'CastleStoryPlus.Tests'">
    <Compile Remove="QuarryDepthStepsTests.cs;SavedContentAuditTests.cs;WorldSearchQueryTests.cs" />
  </ItemGroup>

  <!-- Files shipped next to the plugin (Assets, Lua): Essentials has only its own logo. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'CastleStoryPlus'">
    <EditionExcludedFile Condition="'$(Edition)' == 'Essentials'" Include="Assets/Beasts/**;Assets/Build/**;Assets/Market/**;Assets/Resources/**;Assets/Upgrades/**;Assets/logo.png;Assets/plus.png" />
    <EditionExcludedFile Condition="'$(Edition)' != 'Essentials'" Include="Assets/logo_essentials.png;Assets/plus_essentials.png" />
    <None Remove="@(EditionExcludedFile)" />
  </ItemGroup>
</Project>
